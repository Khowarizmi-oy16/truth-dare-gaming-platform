{
  "name": "truth-dare-gaming-platform",
  "version": "1.0.0",
  "description": "A responsive Truth or Dare party game with local demo, editable prompt bank, and Electron desktop shell.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.truthdare.party",
    "productName": "Truth Dare",
    "files": ["index.html", "styles.css", "app.js", "electron/**/*"],
    "directories": {"output": "release"},
    "mac": {"target": ["dmg"]},
    "win": {"target": ["nsis"]}
  }
}
